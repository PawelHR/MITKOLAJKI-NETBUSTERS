rules_version = '2';
// Bez sekretów. Identyczne reguły lokalnie i przy wdrożeniu.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function admin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function team(t) { return get(/databases/$(database)/documents/teams/$(t)).data; }
    function member(t) { return signed() && exists(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid)); }
    function config() { return get(/databases/$(database)/documents/config/main).data; }
    function registration() { return config().phase == 'registration'; }
    function linkedCode(t,d) {
      return d.joinCode.matches('^[A-Z2-9]{6}$')
        && getAfter(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.teamId == t;
    }
    function joinByCode(t,uid,d) {
      return request.auth.uid == uid && registration() && d.get('joinCode','').matches('^[A-Z2-9]{6}$') && team(t).registrationOpen
        && !exists(/databases/$(database)/documents/teams/$(t)/revoked/$(uid))
        && team(t).get('joinCode','') == d.joinCode
        && get(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.teamId == t;
    }
    function playing() { return config().phase == 'main' && request.time < config().mainEndsAt; }
    function monotone(old, next, keys) {
      return next is map && next.keys().hasOnly(keys) && next.keys().hasAll(old.keys())
        && next.values().hasOnly([true]);
    }
    function validTeam(d) {
      return d.keys().hasAll(['name','school','createdAt','createdBy','unlocked','side','soc','registrationOpen','bonus'])
        && d.keys().hasOnly(['name','school','createdAt','createdBy','unlocked','side','soc','registrationOpen','bonus','joinCode','memberCount'])
        && (!('joinCode' in d) || (d.joinCode is string && d.joinCode.matches('^[A-Z2-9]{6}$')))
        && (!('memberCount' in d) || (d.memberCount is int && d.memberCount >= 0 && d.memberCount <= 4))
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 28
        && d.school in [0,1,2] && d.registrationOpen is bool
        && d.bonus is int && d.bonus >= 0 && d.bonus <= 100
        && monotone({},d.unlocked,['s1','s2','s3','s4'])
        && monotone({},d.side,['p1','p2','p3','p4','p5','p6','p7','p8','p9'])
        && monotone({},d.soc,['open','mail','idor','logs','triage','resp']);
    }
    function mirrored(t, d) {
      let p = getAfter(/databases/$(database)/documents/leaderboard/$(t)).data;
      return p.name == d.name && p.school == d.school && p.unlocked == d.unlocked && p.bonus == d.bonus;
    }
    function award(t, id, old, next) {
      return (id in old && next[id] == old[id]) || (!(id in old) && !(id in next))
        || (!(id in old) && id in next && next[id] == true
          && !exists(/databases/$(database)/documents/teams/$(t)/awards/$(id))
          && existsAfter(/databases/$(database)/documents/teams/$(t)/awards/$(id)));
    }
    function stationUpdate(t) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlocked'])
        && monotone(resource.data.unlocked,request.resource.data.unlocked,['s1','s2','s3','s4'])
        && request.resource.data.unlocked.diff(resource.data.unlocked).addedKeys().size() == 1
        && mirrored(t,request.resource.data)
        && award(t,'s1',resource.data.unlocked,request.resource.data.unlocked)
        && award(t,'s2',resource.data.unlocked,request.resource.data.unlocked)
        && award(t,'s3',resource.data.unlocked,request.resource.data.unlocked)
        && award(t,'s4',resource.data.unlocked,request.resource.data.unlocked);
    }
    function educationalUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['side','soc'])
        // p9 pozostaje wyłącznie jako historyczne dane, bez nowego zaliczania.
        && monotone(resource.data.side,request.resource.data.side,['p1','p2','p3','p4','p5','p6','p7','p8','p9'])
        && request.resource.data.side.diff(resource.data.side).addedKeys().hasOnly(['p1','p2','p3','p4','p5','p6','p7','p8'])
        && request.resource.data.side.diff(resource.data.side).addedKeys().size()
           + request.resource.data.soc.diff(resource.data.soc).addedKeys().size() == 1
        && monotone(resource.data.soc,request.resource.data.soc,['open','mail','idor','logs','triage','resp'])
        && (request.resource.data.soc == resource.data.soc || resource.data.soc.get('open',false)
          || request.resource.data.soc.diff(resource.data.soc).affectedKeys().hasOnly(['open']))
        && (!request.resource.data.soc.get('resp',false) || resource.data.soc.get('resp',false)
          || (resource.data.soc.get('mail',false) && resource.data.soc.get('idor',false) && resource.data.soc.get('logs',false) && resource.data.soc.get('triage',false)));
    }
    function adminUpdate(t) {
      return mirrored(t,request.resource.data)
        && (request.resource.data.get('joinCode','') == resource.data.get('joinCode','') || linkedCode(t,request.resource.data))
        && monotone(resource.data.unlocked,request.resource.data.unlocked,['s1','s2','s3','s4'])
        && (request.resource.data.unlocked == resource.data.unlocked || (
          award(t,'s1',resource.data.unlocked,request.resource.data.unlocked)
          && award(t,'s2',resource.data.unlocked,request.resource.data.unlocked)
          && award(t,'s3',resource.data.unlocked,request.resource.data.unlocked)
          && award(t,'s4',resource.data.unlocked,request.resource.data.unlocked)))
        && (request.resource.data.bonus == resource.data.bonus || config().phase == 'final');
    }
    function submittedFlag(id,d) {
      return d.get('flag','') is string && d.get('flag','').matches('^[A-Z0-9_-]{4,40}$')
        && get(/databases/$(database)/documents/stationFlags/$(id)).data.active == true
        && get(/databases/$(database)/documents/stationFlags/$(id)).data.value == d.flag;
    }
    // Limit 4 osób: licznik zmienia się o 1 wyłącznie razem z dołączeniem/odejściem tego UID.
    // Drużyny bez licznika (sprzed limitu) nie przyjmują nowych osób, dopóki organizator go nie ustawi.
    function memberCountUpdate(t) {
      let old = resource.data;
      let next = request.resource.data;
      let me = /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid);
      return next.diff(old).affectedKeys().hasOnly(['memberCount']) && 'memberCount' in old
        && ((next.memberCount == old.memberCount + 1 && !exists(me) && existsAfter(me))
          || (next.memberCount == old.memberCount - 1 && exists(me) && !existsAfter(me)));
    }
    function countUp(t) {
      return getAfter(/databases/$(database)/documents/teams/$(t)).data.get('memberCount',-1) == team(t).get('memberCount',-100) + 1;
    }
    function countDown(t) {
      return !exists(/databases/$(database)/documents/teams/$(t)) || !('memberCount' in team(t))
        || getAfter(/databases/$(database)/documents/teams/$(t)).data.get('memberCount',-1) == team(t).memberCount - 1;
    }
    function updateTeam(t) {
      let old = resource.data;
      let next = request.resource.data;
      let changed = next.diff(old).affectedKeys();
      return (admin() ? adminUpdate(t) : memberCountUpdate(t) || member(t) && (
        (playing() && (changed.hasOnly(['unlocked']) ? stationUpdate(t) : educationalUpdate()))
        || (registration() && old.createdBy == request.auth.uid && changed.hasOnly(['registrationOpen','joinCode'])
          && (next.get('joinCode','') == old.get('joinCode','') || linkedCode(t,next)))
      )) && validTeam(next);
    }
    match /stationFlags/{id} { allow read, write: if false; }
    match /admins/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /config/main {
      allow read: if true;
      allow write: if admin() && request.resource.data.phase in ['registration','main','break','final','ended']
        && request.resource.data.mainEndsAt is timestamp;
    }
    match /invites/{token} {
      allow get: if admin();
      allow list: if false;
      allow create: if signed() && registration() && token.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['teamId','expiresAt'])
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && (admin() || (!exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
          && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid));
      allow delete: if admin();
      allow update: if false;
    }
    // Krótki kod jest biletem wstępu, nie publicznym ID. Brak listowania.
    match /joinCodes/{code} {
      allow get: if admin() || (signed() && team(resource.data.teamId).get('joinCode','') == code
        && (member(resource.data.teamId) || (registration() && team(resource.data.teamId).registrationOpen)));
      allow list: if false;
      allow create: if signed() && registration() && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['teamId','createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.joinCode == code
        && (admin() || (getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid
          && (member(request.resource.data.teamId) || !exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId)))));
      allow update, delete: if false;
    }
    match /leaderboard/{t} {
      allow read: if true;
      allow create, update: if signed()
        && request.resource.data.keys().hasOnly(['name','school','unlocked','bonus','updatedAt'])
        && monotone({},request.resource.data.unlocked,['s1','s2','s3','s4'])
        && request.resource.data.bonus is int && request.resource.data.bonus >= 0 && request.resource.data.bonus <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name == getAfter(/databases/$(database)/documents/teams/$(t)).data.name
        && request.resource.data.school == getAfter(/databases/$(database)/documents/teams/$(t)).data.school
        && request.resource.data.unlocked == getAfter(/databases/$(database)/documents/teams/$(t)).data.unlocked
        && request.resource.data.bonus == getAfter(/databases/$(database)/documents/teams/$(t)).data.bonus
        && (admin() || (member(t) && playing()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlocked','updatedAt'])
          && request.resource.data.unlocked.diff(resource.data.unlocked).addedKeys().size() == 1)
        || (!exists(/databases/$(database)/documents/teams/$(t))
          && getAfter(/databases/$(database)/documents/teams/$(t)).data.createdBy == request.auth.uid));
      allow delete: if admin();
    }
    match /teams/{t} {
      allow get, list: if admin() || member(t);
      allow create: if signed() && registration() && t.matches('^[A-Z2-9]{4}$')
        && !exists(/databases/$(database)/documents/retiredTeams/$(t))
        && validTeam(request.resource.data) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.registrationOpen == true
        && request.resource.data.unlocked == {} && request.resource.data.side == {}
        && request.resource.data.soc == {} && request.resource.data.bonus == 0
        && request.resource.data.memberCount == 1
        && linkedCode(t,request.resource.data)
        && existsAfter(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid))
        && mirrored(t,request.resource.data);
      allow update: if signed() && updateTeam(t);
      allow delete: if admin() && existsAfter(/databases/$(database)/documents/retiredTeams/$(t));
      match /members/{uid} {
        allow read: if admin() || member(t);
        allow create: if signed() && request.resource.data.keys().hasOnly(['nick','joinedAt','joinCode'])
          && request.resource.data.nick is string && request.resource.data.nick.size() <= 20
          && request.resource.data.joinedAt == request.time
          && ((joinByCode(t,uid,request.resource.data) && countUp(t))
          || (admin() && registration() && team(t).registrationOpen
            && !exists(/databases/$(database)/documents/teams/$(t)/revoked/$(uid))
            && exists(/databases/$(database)/documents/teams/$(t)/requests/$(uid)) && countUp(t))
          || (request.auth.uid == uid && !exists(/databases/$(database)/documents/teams/$(t))
            && getAfter(/databases/$(database)/documents/teams/$(t)).data.createdBy == uid));
        allow update: if false;
        allow delete: if (admin() || (signed() && request.auth.uid == uid)) && countDown(t);
      }
      match /requests/{uid} {
        allow get: if admin() || (signed() && request.auth.uid == uid);
        allow list: if admin();
        allow create: if signed() && request.auth.uid == uid && registration() && team(t).registrationOpen
          && !exists(/databases/$(database)/documents/teams/$(t)/members/$(uid))
          && !exists(/databases/$(database)/documents/teams/$(t)/revoked/$(uid))
          && request.resource.data.keys().hasOnly(['nick','token','at'])
          && request.resource.data.nick is string && request.resource.data.nick.size() <= 20
          && request.resource.data.at == request.time && request.resource.data.token.matches('^[a-f0-9]{32}$')
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.teamId == t
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.expiresAt > request.time;
        allow update: if false;
        allow delete: if admin() || (signed() && request.auth.uid == uid);
      }
      match /revoked/{uid} { allow read, write: if admin(); }
      match /awards/{id} {
        allow read: if admin() || member(t);
        allow create: if signed() && id in ['s1','s2','s3','s4']
          && request.resource.data.keys().hasOnly(['by','at','emergency','reason','flag'])
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
          && ((member(t) && playing() && request.resource.data.emergency == false
              && request.resource.data.reason == 'Flaga stacji' && submittedFlag(id,request.resource.data))
            || (admin() && !('flag' in request.resource.data)
              && ((playing() && request.resource.data.emergency == false)
                || (request.resource.data.emergency == true && request.resource.data.reason.size() >= 5))))
          && !(id in team(t).unlocked)
          && getAfter(/databases/$(database)/documents/teams/$(t)).data.unlocked[id] == true;
        allow update, delete: if false;
      }
    }
    // Nie używamy ponownie ID z pozostałymi podkolekcjami starej drużyny.
    match /retiredTeams/{t} {
      allow create: if admin();
      allow read, update, delete: if false;
    }
  }
}
